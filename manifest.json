{
  "manifest_version": 3,
  "name": "Duplicate Tab Guard",
  "version": "1.0.0",
  "description": "Asks before opening a link in a new tab when that link is already open in another tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Duplicate this tab (no prompt)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "duplicate-without-prompt": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Duplicate the current tab without the duplicate prompt"
    }
  }
}
